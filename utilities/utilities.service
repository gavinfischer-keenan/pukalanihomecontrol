[Unit]
Description=Pukalani Utilities (PDF Maker + Shrinker)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/utilities/app
ExecStart=/opt/utilities/venv/bin/uvicorn main:app --host 0.0.0.0 --port 3114 --workers 2
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYOPENGL_PLATFORM=osmesa
Environment=DISPLAY=:0

[Install]
WantedBy=multi-user.target
