[Unit]
Description=Corner Monitor HDMI Kiosk Browser
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=root
Type=simple
ExecStart=/usr/bin/xinit /opt/corner-kiosk/start-kiosk.sh -- :0 vt1 -nolisten tcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
